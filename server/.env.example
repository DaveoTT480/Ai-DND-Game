# Copy to .env (or export in your shell) before running the server.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for the Dungeon Master. claude-opus-5 is the default.
DM_MODEL=claude-opus-5
# Reasoning effort for story turns: low | medium | high | xhigh | max
DM_EFFORT=medium

# Shared secret. When set, clients must send "Authorization: Bearer <token>".
# Optional for local play; REQUIRED on Vercel (the server refuses every request without it).
# Generate one with: openssl rand -base64 32
GAME_API_TOKEN=

# Spend guard: maximum model calls per UTC day across all games. 0 = unlimited.
# Defaults to 300 on Vercel and unlimited locally. Each turn is one call.
DM_DAILY_CALL_LIMIT=

# Painted portraits (optional). Anthropic has no image model, so an image API key is needed.
# With OPENAI_API_KEY set, each forged hero gets a painted portrait from gpt-image-1
# (about 4 cents per portrait at medium quality). Leave empty to use the drawn portraits.
OPENAI_API_KEY=
IMAGE_PROVIDER=
IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=medium

# Set to 1 to insist on a token even for local runs.
REQUIRE_API_TOKEN=0

# Where saved adventures are written as JSON files (local runs).
# On Vercel, connect a Blob store instead; BLOB_READ_WRITE_TOKEN is injected automatically.
DATA_DIR=./data

# Set to 1 to run without an API key using a scripted mock Dungeon Master.
DM_MOCK=0

PORT=8787
