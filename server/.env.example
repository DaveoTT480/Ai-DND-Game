# Copy to .env (or export in your shell) before running the server.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for the Dungeon Master. claude-opus-5 is the default.
DM_MODEL=claude-opus-5
# Reasoning effort for story turns: low | medium | high | xhigh | max
DM_EFFORT=medium

# Optional shared secret. When set, clients must send "Authorization: Bearer <token>".
GAME_API_TOKEN=

# Where saved adventures are written as JSON files (local runs).
# On Vercel, connect a Blob store instead; BLOB_READ_WRITE_TOKEN is injected automatically.
DATA_DIR=./data

# Set to 1 to run without an API key using a scripted mock Dungeon Master.
DM_MOCK=0

PORT=8787
